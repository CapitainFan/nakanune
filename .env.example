# Скопируй в .env (`cp .env.example .env`). Этот файл читают сервер (apps/server)
# и Prisma (packages/db). Переменные фронта лежат в apps/web/.env.example.

# --- База (Этап 0) ---
# Совпадает с docker-compose.yml (порт 5433, а не стандартный 5432)
DATABASE_URL=postgresql://nakanune:nakanune@localhost:5433/nakanune

# --- Сервер (Этап 0) ---
PORT=4000
# Только этот компьютер. 0.0.0.0 открыл бы API без авторизации всей сети — не надо
HOST=127.0.0.1
# Откуда браузеру разрешено ходить в API (CORS)
# Ключ доступа к API — обязателен, если сервер открыт в интернет через ngrok (иначе сервер
# откажет запросам через туннель). Его же вводишь один раз на сайте. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
# Откуда фронту можно ходить к API; несколько — через запятую:
# WEB_ORIGIN=http://localhost:3000,https://nakanune.vercel.app
WEB_ORIGIN=http://localhost:3000

# --- Расписание пар ---
# Когда перепроверять сайт ММФ (время по Минску). Ещё проверка идёт при открытии
# приложения, если с прошлой прошло больше 6 часов.
SCHEDULE_CRON="0 6 * * *"

# --- ИИ (Этап 3) ---
# https://aistudio.google.com/app/apikey. Без ключа текст разбирается эвристикой.
GEMINI_API_KEY=
# gemini-2.5-flash Google открывает не всем новым проектам — тогда цепочка перейдёт к следующей
# Модели по очереди: на бесплатном тарифе новые часто отвечают 503 — тогда пробуется следующая
GEMINI_MODELS=gemini-2.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# --- Шифрование секретов источников (Этап 4) ---
# Им шифруется ссылка на календарь Moodle (в ней личный токен). Сменишь ключ — источники
# придётся добавить заново. 32 байта в base64: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Cron (Этап 4) ---
# Как часто проверять источники заданий (календарь Moodle). По умолчанию — раз в час
CRON_SCHEDULE="0 * * * *"

# --- Telegram (Этап 5) ---
# api_id и api_hash — на https://my.telegram.org → API development tools. Потом вход: `pnpm tg:login`.
# Сессия (полный доступ к аккаунту) сохраняется в базе зашифрованной ключом ENCRYPTION_KEY,
# в .env её нет.
TG_API_ID=
TG_API_HASH=
