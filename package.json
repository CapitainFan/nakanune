{
  "name": "nakanune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nakanune/server --filter @nakanune/web dev",
    "dev:web": "pnpm --filter @nakanune/web dev",
    "dev:server": "pnpm --filter @nakanune/server dev",
    "start:server": "pnpm --filter @nakanune/server start",
    "build": "pnpm --filter @nakanune/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm --filter @nakanune/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @nakanune/db generate",
    "db:migrate": "pnpm --filter @nakanune/db migrate",
    "db:deploy": "pnpm --filter @nakanune/db migrate:deploy",
    "db:seed": "pnpm --filter @nakanune/db seed",
    "db:reset": "pnpm --filter @nakanune/db reset",
    "db:studio": "pnpm --filter @nakanune/db studio",
    "tg:login": "pnpm --filter @nakanune/server tg:login",
    "tg:logout": "pnpm --filter @nakanune/server tg:logout",
    "schedule:snapshot": "pnpm --filter @nakanune/server schedule:snapshot"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1"
  }
}
